  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "onnxruntime-web": "1.24.3"
