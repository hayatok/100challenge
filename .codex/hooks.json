{
  "description": "100challenge only: review this turn's changes for unsupported claims, unfinished behavior, and unnecessary filler.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/quality.mjs\"",
            "timeout": 20,
            "statusMessage": "Recording this turn's quality baseline",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/quality.mjs\"",
            "timeout": 20,
            "statusMessage": "Checking this turn's changes before completion"
          }
        ]
      }
    ]
  }
}
