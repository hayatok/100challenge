{
  "name": "local-audio-cutter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check": "npm run verify:aac && npm run test && npm run lint && npm run build && npm run test:e2e",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "setup": "playwright install --with-deps chromium",
    "verify:aac": "node scripts/verify-aac.mjs"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "file:vendor/aac-encoder",
    "@mediabunny/mp3-encoder": "1.61.6",
    "mediabunny": "1.61.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
