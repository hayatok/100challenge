config_version=5
[application]
config/name="こわさず、壊す。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/min_width=1000
window/size/min_height=720
window/stretch/mode="disabled"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.925,0.906,0.863,1)
textures/vram_compression/import_etc2_astc=true
[physics]
common/physics_ticks_per_second=120
common/physics_interpolation=true
2d/default_gravity=600.0
2d/solver/solver_iterations=24
[layer_names]
2d_physics/layer_1="Architecture"
2d_physics/layer_2="Ceramics"
