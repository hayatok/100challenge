{
  "name": "type-motion-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "predev": "node scripts/build-player.mjs",
    "pretypecheck": "node scripts/build-player.mjs",
    "prebuild": "node scripts/build-player.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.0",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "mediabunny": "1.59.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "oxlint": "1.79.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
