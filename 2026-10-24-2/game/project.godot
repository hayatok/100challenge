; Godot 4.7.2
config_version=5

[application]
config/name="雲海サーファー"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="CLOUDSEA SURFER — carve, release and jump across a 900m sky course"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.42, 0.69, 0.88, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/default_gravity=18.0

[layer_names]
3d_physics/layer_1="Rider"
3d_physics/layer_2="Course"

[debug]
gdscript/warnings/treat_warnings_as_errors=false
