static func sample(clip: StringName, time: float) -> Array[float]:
	var result: Array[float] = []
	result.resize(9)
	result.fill(0.0)
	if not CLIPS.has(String(clip)):
		return result
	var keys: Array = CLIPS[String(clip)]
	var left: Array = keys[0]
	var right: Array = keys[-1]
	for index in range(1, keys.size()):
		if time <= float(keys[index][0]):
			left = keys[index - 1]
			right = keys[index]
			break
	var weight := clampf((time - float(left[0])) / maxf(0.001, float(right[0]) - float(left[0])), 0, 1)
	weight = weight * weight * (3.0 - 2.0 * weight)
	for index in 9:
		result[index] = lerpf(float(left[1][index]), float(right[1][index]), weight)
	return result

static func duration(clip: StringName) -> float:
	return float(CLIPS[String(clip)][-1][0]) if CLIPS.has(String(clip)) else 0.0
